# Copy to .env and fill in your own keys.
# These are only needed if you want to re-collect raw data from scratch
# (Step 1 inputs). The shipped pipeline starts from sandwiches_recall_wide.jsonl
# and does NOT require API access.

# Helius enhanced-tx API: https://docs.helius.dev/
HELIUS_API_KEY=your_helius_key_here

# Solana RPC (any provider works; Chainstack used in original collection)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jito bundle API has no auth requirement at time of writing.
# Endpoint: https://bundles.jito.wtf/api/v1/bundles
